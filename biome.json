{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/routeTree.gen.ts",
      "!**/drizzle/meta",
      "!**/playwright-report",
      "!**/test-results",
      "!.semgrep",
      "!docs/db"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noConsole": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 300,
            "skipBlankLines": true
          }
        }
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 15
          }
        },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 80,
            "skipBlankLines": true
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/scripts/**",
        "**/*.config.ts",
        ".claude/hooks/**",
        "**/test/**",
        "**/e2e/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["prototypes/**"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": "off",
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@app/*", "!@app/ui", "!@app/ui/*"],
                    "message": "試作から使ってよいのは @app/ui(デザインシステム)だけ。本物の API・DB には触らない"
                  },
                  {
                    "group": [
                      "@aws-sdk/*",
                      "aws-sdk",
                      "@smithy/*",
                      "pg",
                      "postgres",
                      "drizzle-orm",
                      "drizzle-orm/*",
                      "@sentry/*",
                      "dotenv",
                      "pino"
                    ],
                    "message": "試作から AWS・DB・監視・秘密の設定には触らない。値は偽のデータとして src に書く"
                  },
                  {
                    "group": ["**/apps/**", "**/packages/**", "**/.env*"],
                    "message": "試作のフォルダの外(apps・packages)や .env を読まない"
                  }
                ]
              }
            }
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "noExcessiveLinesPerFunction": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
