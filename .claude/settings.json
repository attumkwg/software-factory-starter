{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform import:*)",
      "Bash(terraform state:*)",
      "Bash(aws:*)",
      "Bash(git push --force:*)",
      "Bash(gh pr merge:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push --no-verify:*)",
      "Bash(git push --delete:*)",
      "Bash(gh pr review --approve:*)"
    ],
    "ask": [
      "Edit(./apps/api/src/auth/**)",
      "Edit(./apps/api/src/authz/**)",
      "Edit(./apps/api/src/db/**)",
      "Edit(./apps/api/test/unit/classification.test.ts)",
      "Edit(./apps/api/src/logger.ts)",
      "Edit(./packages/error-reporting/**)",
      "Edit(./packages/logging/**)",
      "Edit(./apps/web/server/logger.ts)",
      "Edit(./apps/api/test/integration/personal-data-logs.int.test.ts)",
      "Edit(./apps/api/drizzle/**)",
      "Edit(./apps/api/db/**)",
      "Edit(./apps/api/Dockerfile)",
      "Edit(./apps/web/Dockerfile)",
      "Edit(./docker/**)",
      "Edit(./docs/authz/**)",
      "Edit(./infra/**)",
      "Edit(./.github/**)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/hooks/**)",
      "Edit(./.semgrep/**)",
      "Edit(./scripts/checkup/**)",
      "Edit(./scripts/setup/**)",
      "Edit(./.gitleaksignore)",
      "Edit(./.trivyignore.yaml)",
      "Edit(./renovate.json)",
      "Edit(./pnpm-workspace.yaml)",
      "Edit(./.npmrc)",
      "Write(./apps/api/src/auth/**)",
      "Write(./apps/api/src/authz/**)",
      "Write(./apps/api/src/db/**)",
      "Write(./apps/api/test/unit/classification.test.ts)",
      "Write(./apps/api/src/logger.ts)",
      "Write(./packages/error-reporting/**)",
      "Write(./packages/logging/**)",
      "Write(./apps/web/server/logger.ts)",
      "Write(./apps/api/test/integration/personal-data-logs.int.test.ts)",
      "Write(./apps/api/drizzle/**)",
      "Write(./apps/api/db/**)",
      "Write(./apps/api/Dockerfile)",
      "Write(./apps/web/Dockerfile)",
      "Write(./docker/**)",
      "Write(./docs/authz/**)",
      "Write(./infra/**)",
      "Write(./.github/**)",
      "Write(./.claude/settings.json)",
      "Write(./.claude/hooks/**)",
      "Write(./.semgrep/**)",
      "Write(./scripts/checkup/**)",
      "Write(./scripts/setup/**)",
      "Write(./.gitleaksignore)",
      "Write(./.trivyignore.yaml)",
      "Write(./renovate.json)",
      "Write(./pnpm-workspace.yaml)",
      "Write(./.npmrc)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.mjs\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify.mjs\"",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
