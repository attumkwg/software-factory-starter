{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform import:*)",
      "Bash(terraform state:*)",
      "Bash(aws:*)",
      "Bash(git push --force:*)",
      "Bash(gh pr merge:*)"
    ],
    "ask": [
      "Edit(./.github/**)",
      "Edit(./.claude/settings.json)",
      "Edit(./infra/**)",
      "Edit(./docs/authz/**)",
      "Edit(./apps/api/src/auth/**)",
      "Edit(./apps/api/src/authz/**)",
      "Edit(./apps/api/drizzle/**)",
      "Write(./.github/**)",
      "Write(./.claude/settings.json)",
      "Write(./infra/**)",
      "Write(./docs/authz/**)",
      "Write(./apps/api/src/auth/**)",
      "Write(./apps/api/src/authz/**)",
      "Write(./apps/api/drizzle/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.mjs\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify.mjs\"",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
