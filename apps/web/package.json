{
  "name": "@app/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#ssr": "./dist/server/server.js"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/build-server.mjs && node scripts/precompress.mjs",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "vrt": "playwright test -c playwright.vrt.config.ts",
    "verify": "playwright test -c playwright.verify.config.ts",
    "vrt:update": "playwright test -c playwright.vrt.config.ts --update-snapshots=changed",
    "size": "node scripts/check-bundle-size.mjs"
  },
  "dependencies": {
    "@app/error-reporting": "workspace:*",
    "@app/logging": "workspace:*",
    "@app/shared": "workspace:*",
    "@app/ui": "workspace:*",
    "@tanstack/react-router": "1.170.44",
    "@sentry/browser": "11.8.0",
    "@tanstack/react-start": "1.169.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@app/fake-cognito": "workspace:*",
    "@axe-core/playwright": "4.13.0",
    "@hono/node-server": "2.1.4",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "hono": "4.13.13",
    "pino": "10.4.0",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
