# cp .env.example .env → pnpm dev(DB は docker compose up -d db)
APP_ENV=local
AUTH_MODE=dev
PORT=3000
LOG_LEVEL=debug
# アプリの接続ユーザー(表の持ち主ではない・RLS がかかる)
DATABASE_URL=postgres://app:app@localhost:5432/app
# 移行と種データ用(表の持ち主)
MIGRATION_DATABASE_URL=postgres://app_owner:app_owner@localhost:5432/app
SESSION_SECRET=local-dev-only-session-secret-not-used-anywhere
