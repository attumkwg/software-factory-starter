{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --project integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/cli.ts migrate",
    "db:seed": "tsx --env-file-if-exists=.env src/cli.ts seed",
    "db:lint": "squawk --config=.squawk.toml drizzle/*.sql && squawk --config=.squawk.toml --no-assume-in-transaction drizzle/concurrent/*.sql",
    "openapi": "tsx scripts/openapi.ts",
    "docs:personal-data": "tsx scripts/personal-data-ledger.ts"
  },
  "dependencies": {
    "@app/error-reporting": "workspace:*",
    "@app/logging": "workspace:*",
    "@app/shared": "workspace:*",
    "@aws-sdk/client-kms": "3.1152.0",
    "@hono/node-server": "2.1.4",
    "@hono/zod-openapi": "1.6.3",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "jose": "6.2.12",
    "nodemailer": "10.1.4",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@app/fake-cognito": "workspace:*",
    "@testcontainers/postgresql": "12.2.0",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "squawk-cli": "2.68.0",
    "testcontainers": "12.2.0",
    "tsx": "4.23.15",
    "vitest": "5.0.4",
    "yaml": "2.9.1"
  }
}
