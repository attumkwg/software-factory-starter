{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests",
    ":semanticCommitsDisabled",
    ":pinAllExceptPeerDependencies"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 9am on monday"],
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 5,
  "labels": ["dependencies"],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/tests/**",
    "**/__fixtures__/**"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on the first day of the month"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "CI の道具の Docker イメージ(ワークフローの `*_IMAGE: 名前:タグ@sha256:…`)。タグとダイジェストを一緒に上げる",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "_IMAGE: (?<depName>[^\\s:@$]+):(?<currentValue>[^\\s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "ワークフローの TF_VERSION(Terraform 本体。リリースのタグは v1.2.3)",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": ["\\bTF_VERSION: (?<currentValue>\\d+\\.\\d+\\.\\d+)\\b"],
      "depNameTemplate": "hashicorp/terraform",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "ワークフローの TFLINT_VERSION(リリースのタグは v0.1.2)",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": ["\\bTFLINT_VERSION: (?<currentValue>v\\d+\\.\\d+\\.\\d+)\\b"],
      "depNameTemplate": "terraform-linters/tflint",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "結合テストの Postgres(global-setup.ts の `const POSTGRES_IMAGE =` の次の行)。docker-compose の postgres と同じ版・同じダイジェストにそろえる。ダイジェストつきは1行に収まらないので、Biome の整形と同じく「=」の後で改行した形で書き戻す(1行に戻すと Biome で落ちる)。config:recommended は test/ を読まないので、ignorePaths から test/ だけ外している",
      "managerFilePatterns": ["/^apps/api/test/integration/global-setup\\.ts$/"],
      "matchStrings": [
        "const POSTGRES_IMAGE =\\s*\"(?<depName>postgres):(?<currentValue>[^\"@]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?\";"
      ],
      "autoReplaceStringTemplate": "const POSTGRES_IMAGE =\n  \"{{depName}}:{{newValue}}{{#if newDigest}}@{{newDigest}}{{/if}}\";",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "見た目の回帰テストのブラウザ(docker-compose.vrt.yml の `npx -y playwright@1.2.3 run-server`)。@playwright/test・イメージのタグと同じ版にそろえる(apps/web/e2e/vrt/versions.test.ts が見張る)",
      "managerFilePatterns": ["/^docker-compose\\.vrt\\.yml$/"],
      "matchStrings": ["\"playwright@(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
      "depNameTemplate": "playwright",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": "開発用の依存の小さい更新はまとめて1本(危険度: 低)",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "dev dependencies (minor/patch)",
      "addLabels": ["risk:low"]
    },
    {
      "description": "本番で動く依存は1つずつ(危険度: 中)",
      "matchDepTypes": ["dependencies"],
      "addLabels": ["risk:medium"]
    },
    {
      "description": "大きい版の更新は、Dependency Dashboard でチェックを入れたときだけ PR にする(危険度: 高。人が2人で見る)",
      "matchUpdateTypes": ["major"],
      "addLabels": ["risk:high"],
      "dependencyDashboardApproval": true
    },
    {
      "matchManagers": [
        "github-actions",
        "terraform",
        "dockerfile",
        "docker-compose",
        "custom.regex"
      ],
      "addLabels": ["risk:high"]
    },
    {
      "description": "Terraform の AWS プロバイダーはまとめて",
      "matchManagers": ["terraform"],
      "matchPackageNames": ["hashicorp/aws"],
      "groupName": "terraform aws provider"
    },
    {
      "description": "Terraform の版の幅(モジュールの `~> 6.0`・`required_version` の `>= 1.10`)は固定しない。固定は .terraform.lock.hcl に任せ、幅の中の更新はロックファイルだけ上げる",
      "matchManagers": ["terraform"],
      "rangeStrategy": "update-lockfile"
    },
    {
      "description": "Node.js の本体(.node-version・Dockerfile の node・engines)は1本にまとめて上げる",
      "matchPackageNames": ["node"],
      "groupName": "node runtime"
    },
    {
      "description": "Node.js の大きい版は @types/node も同じ PR で。Renovate が読めない所(distroless の nodejs24-debian13 の名前)は同じ PR で手で直す",
      "matchPackageNames": ["node", "@types/node"],
      "matchUpdateTypes": ["major"],
      "groupName": "node runtime (major)",
      "prBodyNotes": [
        "⚠️ 同じ PR で手で直す: apps/api/Dockerfile・apps/web/Dockerfile の `gcr.io/distroless/nodejs24-debian13` の数字(Renovate は名前の中の版を上げない)。CI の setup-node は .node-version を読むので直さなくてよい"
      ]
    },
    {
      "description": "Postgres は docker-compose と結合テストを1本にまとめる。本番の Aurora と同じ大きい版に置く",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["postgres"],
      "groupName": "postgres"
    },
    {
      "description": "Postgres の大きい版は、Aurora がその版に上がってから承認する(Aurora の版は Renovate が読めない)",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["postgres"],
      "matchUpdateTypes": ["major"],
      "prBodyNotes": [
        "⚠️ 先に本番の Aurora をこの大きい版に上げる: infra/terraform/modules/aurora/variables.tf の `engine_version`(パラメータグループの family も変わる)。Aurora が古いままならマージしない"
      ]
    },
    {
      "description": "Playwright は3か所(apps/web の @playwright/test・docker-compose.vrt.yml のイメージのタグと playwright@)を1本にまとめる。版が違うと VRT のブラウザにつながらない。上げたら pnpm vrt:update で基準を撮り直す(Chromium が変わると描き方が少し変わる)",
      "matchPackageNames": ["@playwright/test", "playwright", "mcr.microsoft.com/playwright"],
      "groupName": "playwright",
      "prBodyNotes": [
        "⚠️ 同じ PR で `pnpm vrt:update` を流し、変わった基準の画像を見てからコミットする(docs/guides/vrt.md)"
      ]
    }
  ],
  "vulnerabilityAlerts": { "labels": ["security"], "minimumReleaseAge": null }
}
