{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "globalPassThroughEnv": ["FUZZ_MAX_EXAMPLES"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "test:coverage": {
      "outputs": ["coverage/**"]
    },
    "@app/web#test": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/api/src/audit/actions.ts"],
      "outputs": []
    },
    "@app/web#test:coverage": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/api/src/audit/actions.ts"],
      "outputs": ["coverage/**"]
    },
    "@app/api#test:coverage": {
      "cache": false,
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "cache": false,
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
