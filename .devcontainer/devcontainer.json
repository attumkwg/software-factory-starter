// 人も AI も同じ開発環境(Node・pnpm・Docker・Terraform・Claude Code)。
// 本番の鍵は入れない。AWS の資格情報もマウントしない(AI の環境から本番に届かないように)。
{
  "name": "software-factory-starter",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-24-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/terraform:1": { "tflint": "latest" },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  "forwardPorts": [3000, 5173, 5432],
  "postCreateCommand": "corepack enable && pnpm install && pnpm exec playwright install --with-deps chromium",
  "containerEnv": {
    // Testcontainers が docker-in-docker を使う
    "TESTCONTAINERS_RYUK_DISABLED": "false"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "biomejs.biome",
        "hashicorp.terraform",
        "ms-playwright.playwright",
        "anthropic.claude-code"
      ],
      "settings": {
        "editor.defaultFormatter": "biomejs.biome",
        "editor.formatOnSave": true
      }
    }
  }
  // 次の一歩: AI に任せる時間が長くなったら、外に出られる先を絞る(パッケージの取得先・GitHub・
  // モデルの API だけ)。Anthropic の参考の devcontainer の init-firewall.sh が雛形になる。
}
