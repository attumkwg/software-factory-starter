{
  "name": "software-factory-starter",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:integration": "turbo run test:integration",
    "test:e2e": "pnpm --filter @app/web test:e2e",
    "vrt": "pnpm --filter @app/web vrt",
    "vrt:update": "pnpm --filter @app/web vrt:update",
    "test:all": "pnpm test && pnpm test:integration",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "check": "biome ci . && turbo run typecheck test",
    "db:migrate": "pnpm --filter @app/api db:migrate",
    "db:seed": "pnpm --filter @app/api db:seed",
    "db:generate": "pnpm --filter @app/api db:generate",
    "openapi": "pnpm --filter @app/api openapi",
    "docs:db": "node scripts/docs-db.mjs",
    "docs:personal-data": "pnpm --filter @app/api docs:personal-data",
    "decisions": "node scripts/decisions.mjs",
    "pr:merge-when-green": "node scripts/pr-merge-when-green.mjs",
    "acceptance": "node scripts/acceptance.mjs",
    "verify:lint": "node scripts/verify-lint.mjs",
    "adr": "node scripts/adr.mjs",
    "contrast": "node scripts/contrast.mjs",
    "bets": "node scripts/bets.mjs",
    "kpi": "node scripts/kpi.mjs",
    "vulns": "node scripts/vulns.mjs",
    "vendors": "node scripts/vendors.mjs",
    "checkup": "node scripts/checkup/run.mjs",
    "checkup:answer": "node scripts/checkup/answer-cli.mjs",
    "checkup:adopt": "node scripts/checkup/adopt-cli.mjs",
    "compliance": "node scripts/compliance/run.mjs",
    "cost": "node scripts/cost/run.mjs",
    "sales:pack": "node scripts/sales-pack.mjs",
    "metrics": "node scripts/metrics/run.mjs",
    "evidence": "node scripts/evidence/collect.mjs",
    "setup:github": "node scripts/setup/run.mjs",
    "setup:check": "node scripts/setup/check.mjs",
    "setup:labels": "node scripts/setup/labels-cli.mjs",
    "test:scripts": "node --test scripts/acceptance.test.mjs scripts/bets.test.mjs scripts/bets-roadmap.test.mjs scripts/decisions.test.mjs scripts/vulns.test.mjs scripts/vendors.test.mjs scripts/adr.test.mjs scripts/contrast.test.mjs scripts/checkup/*.test.mjs scripts/setup/*.test.mjs scripts/compliance/*.test.mjs scripts/evidence/*.test.mjs scripts/cost/*.test.mjs scripts/metrics/*.test.mjs scripts/sales-pack.test.mjs scripts/review-count.test.mjs scripts/self-contained.test.mjs scripts/gaps.test.mjs scripts/verify-lint.test.mjs .github/scripts/ci-scope.test.mjs .github/scripts/ai-input-authors.test.mjs .github/scripts/ai-open-prs.test.mjs scripts/test-weakening.test.mjs scripts/pr-merge.test.mjs scripts/kpi.test.mjs",
    "security:fuzz": "node scripts/security-fuzz.mjs",
    "guards": "node scripts/check-guards.mjs",
    "outbound": "node scripts/outbound.mjs",
    "self-contained": "node scripts/self-contained.mjs",
    "gaps": "node scripts/gaps.mjs",
    "prototypes": "node scripts/prototypes.mjs",
    "prototype:dev": "node scripts/prototypes.mjs dev",
    "kit:catalog": "node scripts/kit/catalog.mjs && node --test scripts/kit/kit.test.mjs",
    "kit:readme": "node scripts/kit/readme.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@vitest/coverage-v8": "5.0.4",
    "turbo": "2.11.7",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  }
}
