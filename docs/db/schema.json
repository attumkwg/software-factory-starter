          "nullable": true
        },
        {
          "name": "dead_at",
          "type": "timestamp with time zone",
          "nullable": true,
          "comment": "あきらめた時刻(人が見て直す)"
        },
        {
          "name": "last_error",
          "type": "text",
          "nullable": true
        }
      ],
