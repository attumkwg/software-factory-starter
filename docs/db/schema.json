    {
      "name": "platform.outbox",
      "type": "BASE TABLE",
      "comment": "送信待ち(アウトボックス)。業務の変更と同じトランザクションで積み、送り出しが後で送る。アプリは書くだけ。docs/adr/0006-outbox.md",
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "nullable": false
        },
        {
          "name": "tenant_id",
          "type": "uuid",
          "nullable": false
        },
        {
          "name": "topic",
          "type": "text",
          "nullable": false,
          "comment": "何が起きたか(領域.出来事。src/outbox/topics.ts)"
        },
        {
          "name": "payload",
          "type": "jsonb",
          "nullable": false
        },
        {
          "name": "created_at",
          "type": "timestamp with time zone",
          "nullable": false,
          "default": "now()"
        },
        {
          "name": "available_at",
          "type": "timestamp with time zone",
          "nullable": false,
          "default": "now()"
        },
        {
          "name": "locked_until",
          "type": "timestamp with time zone",
          "nullable": true,
          "comment": "送り出しが借りている期限"
        },
        {
          "name": "attempts",
          "type": "integer",
          "nullable": false,
          "default": "0"
        },
        {
          "name": "sent_at",
          "type": "timestamp with time zone",
          "nullable": true
        },
        {
          "name": "dead_at",
          "type": "timestamp with time zone",
          "nullable": true,
          "comment": "あきらめた時刻(人が見て直す)"
        },
        {
          "name": "last_error",
          "type": "text",
          "nullable": true
        }
      ],
      "indexes": [
        {
          "name": "outbox_pkey",
          "def": "CREATE UNIQUE INDEX outbox_pkey ON platform.outbox USING btree (id)",
          "table": "platform.outbox",
          "columns": [
            "id"
          ]
        },
        {
          "name": "outbox_pending_idx",
          "def": "CREATE INDEX outbox_pending_idx ON platform.outbox USING btree (available_at) WHERE ((sent_at IS NULL) AND (dead_at IS NULL))",
          "table": "platform.outbox",
          "columns": [
            "available_at"
          ]
        }
      ],
      "constraints": [
        {
          "name": "outbox_tenant_id_tenants_tenant_id_fk",
          "type": "FOREIGN KEY",
          "def": "FOREIGN KEY (tenant_id) REFERENCES organizations.tenants(tenant_id)",
          "table": "platform.outbox",
          "referenced_table": "organizations.tenants",
          "columns": [
            "tenant_id"
          ],
          "referenced_columns": [
            "tenant_id"
          ]
        },
        {
          "name": "outbox_pkey",
          "type": "PRIMARY KEY",
          "def": "PRIMARY KEY (id)",
          "table": "platform.outbox",
          "referenced_table": "",
          "columns": [
            "id"
          ]
        }
      ]
    },
    {
      "name": "platform.audit_events",
      "type": "BASE TABLE",
      "comment": "監査ログ(誰が・いつ・何をしたか)。足すだけで直せない・消せない(トリガー)。値は入れない。docs/specs/0003-audit-log.md・ADR 0013",
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "nullable": false
        },
        {
          "name": "tenant_id",
          "type": "uuid",
          "nullable": false
        },
        {
          "name": "occurred_at",
          "type": "timestamp with time zone",
          "nullable": false,
          "default": "now()"
        },
        {
          "name": "actor_kind",
          "type": "text",
          "nullable": false,
          "comment": "user = 自社の人 / support = 代理ログインの社員 / system = 仕組み"
        },
        {
          "name": "actor_id",
          "type": "uuid",
          "nullable": true
        },
        {
          "name": "action",
          "type": "text",
          "nullable": false,
          "comment": "何をしたか(対象.動作。apps/api/src/audit/actions.ts)"
        },
        {
          "name": "target_type",
          "type": "text",
          "nullable": true
        },
        {
          "name": "target_id",
          "type": "uuid",
          "nullable": true
        },
        {
          "name": "outcome",
          "type": "text",
          "nullable": false,
          "comment": "allowed = できた / denied = 権限が無くて断った"
        },
        {
          "name": "request_id",
          "type": "text",
          "nullable": true
        },
        {
          "name": "details",
          "type": "jsonb",
          "nullable": false,
          "default": "'{}'::jsonb",
          "comment": "直した項目の名前など(値は入れない)"
        }
      ],
      "indexes": [
        {
          "name": "audit_events_pkey",
          "def": "CREATE UNIQUE INDEX audit_events_pkey ON platform.audit_events USING btree (id)",
          "table": "platform.audit_events",
          "columns": [
            "id"
          ]
        },
        {
          "name": "audit_events_tenant_id_idx",
          "def": "CREATE INDEX audit_events_tenant_id_idx ON platform.audit_events USING btree (tenant_id, id DESC NULLS LAST)",
          "table": "platform.audit_events",
          "columns": [
            "tenant_id",
            "id"
          ]
        }
      ],
      "constraints": [
        {
          "name": "audit_events_actor_kind_check",
          "type": "CHECK",
          "def": "CHECK ((actor_kind = ANY (ARRAY['user'::text, 'support'::text, 'system'::text])))",
          "table": "platform.audit_events",
          "referenced_table": "",
          "columns": [
            "actor_kind"
          ]
        },
        {
          "name": "audit_events_outcome_check",
          "type": "CHECK",
          "def": "CHECK ((outcome = ANY (ARRAY['allowed'::text, 'denied'::text])))",
          "table": "platform.audit_events",
          "referenced_table": "",
          "columns": [
            "outcome"
          ]
        },
        {
          "name": "audit_events_tenant_id_tenants_tenant_id_fk",
          "type": "FOREIGN KEY",
          "def": "FOREIGN KEY (tenant_id) REFERENCES organizations.tenants(tenant_id)",
          "table": "platform.audit_events",
          "referenced_table": "organizations.tenants",
          "columns": [
            "tenant_id"
          ],
          "referenced_columns": [
            "tenant_id"
          ]
        },
        {
          "name": "audit_events_pkey",
          "type": "PRIMARY KEY",
          "def": "PRIMARY KEY (id)",
          "table": "platform.audit_events",
          "referenced_table": "",
          "columns": [
            "id"
          ]
        }
      ],
      "triggers": [
        {
          "name": "audit_events_no_update",
          "def": "CREATE TRIGGER audit_events_no_update BEFORE UPDATE ON platform.audit_events FOR EACH ROW EXECUTE FUNCTION platform.audit_events_append_only()"
        },
        {
          "name": "audit_events_no_delete",
          "def": "CREATE TRIGGER audit_events_no_delete BEFORE DELETE ON platform.audit_events FOR EACH ROW EXECUTE FUNCTION platform.audit_events_append_only()"
        },
        {
          "name": "audit_events_no_truncate",
          "def": "CREATE TRIGGER audit_events_no_truncate BEFORE TRUNCATE ON platform.audit_events FOR EACH STATEMENT EXECUTE FUNCTION platform.audit_events_append_only()"
        }
      ]
    },
