          "nullable": false,
          "comment": "何が起きたか(領域.出来事。src/outbox/topics.ts)"
        },
        {
          "name": "payload",
          "type": "jsonb",
          "nullable": false
        },
        {
          "name": "created_at",
          "type": "timestamp with time zone",
          "nullable": false,
          "default": "now()"
        },
        {
          "name": "available_at",
          "type": "timestamp with time zone",
          "nullable": false,
          "default": "now()"
        },
        {
